IMAGE_TAG = "85de1c34"

pipeline {
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    agent {
        label "prd"
    }

    stages {
        stage("get latest tag") {
            steps {
                script {
                  IMAGE_TAG = getLatestTag("atnum-release", "pop-api", "prd")
                }
            }
        }

        stage("generate-sitemaps") {
            steps {
                build job: 'atnum/prd/pop/pop-sitemaps',

                parameters: [
                    string(name: 'ENVIR', value: 'prd'),
                    string(name: 'TAG', value: IMAGE_TAG),
                    string(name: 'BUCKET_NAME', value: 'pop-sitemaps')
                ],
                wait: false
            }
        }
    }
}
